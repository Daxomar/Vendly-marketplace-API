{
  "info": {
    "name": "Vendly API",
    "description": "Stage 1. Run `npm run seed` first. Sign in with a seed login (the cookie is kept automatically), then try the folder for that role. Use Sign out before switching accounts.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "frontendUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "vendorId",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Health",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Origin",
                "value": "{{frontendUrl}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          }
        },
        {
          "name": "Categories (public)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Origin",
                "value": "{{frontendUrl}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "categories"
              ]
            }
          }
        }
      ]
    },
