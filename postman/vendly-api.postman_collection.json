    {
      "name": "4. Admin (sign in as admin)",
      "item": [
        {
          "name": "List vendors",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Origin",
                "value": "{{frontendUrl}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/vendors?status=approved&page=1&limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "vendors"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "approved"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "Create vendor (managed, no password)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{frontendUrl}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/vendors",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "vendors"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ownerName\": \"Yaa Owusu\",\n  \"email\": \"glow@vendly.local\",\n  \"businessName\": \"Glow GH\",\n  \"description\": \"Skincare and beauty\",\n  \"phone\": \"0207778888\",\n  \"pickupLocation\": {\n    \"area\": \"East Legon\",\n    \"city\": \"Accra\"\n  },\n  \"approve\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Copy the returned _id into the vendorId variable and userId into the userId variable."
          }
        },
        {
          "name": "Get vendor",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Origin",
                "value": "{{frontendUrl}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/vendors/{{vendorId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "vendors",
                "{{vendorId}}"
              ]
            }
          }
        },
        {
          "name": "Suspend vendor",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{frontendUrl}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/vendors/{{vendorId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "vendors",
                "{{vendorId}}",
                "status"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"suspended\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Approve vendor",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{frontendUrl}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/vendors/{{vendorId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "vendors",
                "{{vendorId}}",
                "status"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"approved\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Act as vendor (impersonate)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{frontendUrl}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/admin/impersonate-user",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "admin",
                "impersonate-user"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "After this, the Vendor folder requests run as that vendor. GET /me shows impersonatedBy."
          }
        },
        {
          "name": "Stop acting as vendor",
          "request": {
            "method": "POST",
            "header": [
