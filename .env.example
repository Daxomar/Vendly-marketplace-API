# ─────────────────────────────────────────────────────────────
# Vendly API environment
# Copy this file to .env and fill in the values.
# Lines marked REQUIRED must be set or the API refuses to start.
# ─────────────────────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development
# Where the frontend runs (used for CORS, auth redirects and email links)
FRONTEND_URL=http://localhost:3000
# Extra allowed origins, comma separated (optional)
CORS_ORIGINS=

# Database + cache
# These defaults match docker-compose.yml, leave them as they are locally.
# Using MongoDB Atlas instead? Paste its connection string here.
MONGODB_URI=mongodb://localhost:27017/vendly?directConnection=true   # REQUIRED
REDIS_URL=redis://localhost:6379                                     # REQUIRED

# Better Auth
# Generate a secret with:  npm run gen:secret
BETTER_AUTH_SECRET=                                                  # REQUIRED
BETTER_AUTH_URL=http://localhost:5000
# Production only: share login cookies across subdomains, e.g. .vendly.com
COOKIE_DOMAIN=

# Google sign-in (optional; email + password works without it)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (optional locally; without it, verification and reset links
# are printed in the terminal instead of being emailed)
SENDGRID_API_KEY=
EMAIL_FROM=

# Cloudinary: product images and logos. Paste your 3 values from the
# Cloudinary dashboard. Seed data does not need it.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Paystack (needed from Stage 4: checkout)
PAYSTACK_SECRET_KEY=

# Business settings (money is always in pesewas: ₵1.00 = 100)
STOCK_RESERVATION_MINUTES=30
COMMISSION_HOLD_HOURS=24
WITHDRAWAL_FEE_PESEWAS=0
MIN_WITHDRAWAL_PESEWAS=0

# Seed logins (used by `npm run seed`)
SEED_ADMIN_EMAIL=admin@vendly.local
SEED_ADMIN_PASSWORD=ChangeMe123!
# Password given to every seeded vendor and reseller account
SEED_USER_PASSWORD=Password123!
